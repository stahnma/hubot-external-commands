{
  "name": "hubot-external-commands",
  "version": "1.0.0",
  "description": "This is a hubot extension designed to allow you to break free from node and javascript and still have all the chat operations you'd like.",
  "author": "stahnma",
  "license": "MIT",
  "main": "index.js",
  "homepage": "https://github.com/stahnma/hubot-external-commands",
  "scripts": {
    "dev": "HUBOT_EXTERNAL_COMMANDS_DIR=$PWD/fixtures/shell hubot -r src -r fixtures/help --alias \"!\"",
    "test": "node --test test/*_test.mjs",
    "lint": "jshint index.js src/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stahnma/hubot-external-commands.git"
  },
  "keywords": [
    "external",
    "commands",
    "hubot",
    "shell",
    "bot",
    "hubot-scripts"
  ],
  "bugs": {
    "url": "https://github.com/stahnma/hubot-external-commands/issues"
  },
  "devDependencies": {
    "hubot": "^14.1.0",
    "jshint": "^2.13.6"
  },
  "files": [
    "index.js",
    "src"
  ],
  "engines": {
    "node": ">= 18"
  },
  "peerDependencies": {
    "hubot": ">= 11"
  }
}
